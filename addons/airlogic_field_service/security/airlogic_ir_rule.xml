<?xml version="1.0" encoding="utf-8"?>
<!--
  Same pattern as airlogic_core/security/airlogic_ir_rule.xml: a narrow
  rule for Technician paired with a broad one for Supervisor+, relying on
  Odoo unioning (OR-ing) every group-scoped rule a user matches. A
  Manager/Supervisor is also implicitly a Technician (implied_ids), so
  without the broader rule they'd incorrectly inherit the narrow one.

  Reading/checklist lines don't have their own technician_id, so they're
  scoped through job_id.technician_id instead.
-->
<odoo>

    <record id="rule_service_job_technician_own" model="ir.rule">
        <field name="name">Technician: own jobs only</field>
        <field name="model_id" ref="model_airlogic_service_job"/>
        <field name="domain_force">[('technician_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('airlogic_core.group_airlogic_technician'))]"/>
    </record>

    <!-- Broadens Technician read access to any SUBMITTED job, not just
         their own. The Units/History tabs are a shared, client-facing
         view of a unit's whole service record, not a personal log, so a
         technician needs to see a unit's history even for visits another
         technician handled. Draft/in_progress jobs stay own-only
         (protecting active work-in-progress from being seen/tampered
         with by someone else); write/create/unlink stay off this rule on
         purpose (perm_write/create/unlink all 0) so it only ever widens
         *reading*, same OR-combination reasoning as the "own" rule
         above. -->
    <record id="rule_service_job_technician_submitted_all" model="ir.rule">
        <field name="name">Technician: all submitted jobs (shared history), read-only</field>
        <field name="model_id" ref="model_airlogic_service_job"/>
        <field name="domain_force">[('state', '=', 'submitted')]</field>
        <field name="groups" eval="[(4, ref('airlogic_core.group_airlogic_technician'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_service_job_supervisor_all" model="ir.rule">
        <field name="name">Operations Officer+: all jobs</field>
        <field name="model_id" ref="model_airlogic_service_job"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('airlogic_core.group_airlogic_supervisor'))]"/>
    </record>

    <record id="rule_service_job_accounting_closed" model="ir.rule">
        <field name="name">Accounting: submitted jobs only</field>
        <field name="model_id" ref="model_airlogic_service_job"/>
        <field name="domain_force">[('state', '=', 'submitted')]</field>
        <field name="groups" eval="[(4, ref('airlogic_core.group_airlogic_accounting'))]"/>
    </record>

    <record id="rule_reading_line_technician_own" model="ir.rule">
        <field name="name">Technician: reading lines on own jobs only</field>
        <field name="model_id" ref="model_airlogic_reading_line"/>
        <field name="domain_force">[('job_id.technician_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('airlogic_core.group_airlogic_technician'))]"/>
    </record>

    <!-- Same read-only broadening as rule_service_job_technician_submitted_all
         above, for the Units tab's Readings comparison. -->
    <record id="rule_reading_line_technician_submitted_all" model="ir.rule">
        <field name="name">Technician: reading lines on any submitted job, read-only</field>
        <field name="model_id" ref="model_airlogic_reading_line"/>
        <field name="domain_force">[('job_id.state', '=', 'submitted')]</field>
        <field name="groups" eval="[(4, ref('airlogic_core.group_airlogic_technician'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_reading_line_supervisor_all" model="ir.rule">
        <field name="name">Operations Officer+: all reading lines</field>
        <field name="model_id" ref="model_airlogic_reading_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('airlogic_core.group_airlogic_supervisor'))]"/>
    </record>

    <record id="rule_checklist_line_technician_own" model="ir.rule">
        <field name="name">Technician: checklist lines on own jobs only</field>
        <field name="model_id" ref="model_airlogic_checklist_line"/>
        <field name="domain_force">[('job_id.technician_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('airlogic_core.group_airlogic_technician'))]"/>
    </record>

    <!-- Same read-only broadening as rule_service_job_technician_submitted_all
         above, for the Units tab's Visual Checklist comparison and the
         History tab's "main parts" (both need to read another
         technician's flagged/alert items and notes for shared history). -->
    <record id="rule_checklist_line_technician_submitted_all" model="ir.rule">
        <field name="name">Technician: checklist lines on any submitted job, read-only</field>
        <field name="model_id" ref="model_airlogic_checklist_line"/>
        <field name="domain_force">[('job_id.state', '=', 'submitted')]</field>
        <field name="groups" eval="[(4, ref('airlogic_core.group_airlogic_technician'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_checklist_line_supervisor_all" model="ir.rule">
        <field name="name">Operations Officer+: all checklist lines</field>
        <field name="model_id" ref="model_airlogic_checklist_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('airlogic_core.group_airlogic_supervisor'))]"/>
    </record>

    <!-- GLOBAL (no groups field): applies to every user, ANDed on top
         of the own/all rules above, instead of OR-combining with them
         like same-group rules do. Once a job is Submitted, its
         reading/checklist lines are read-only for EVERYONE, Supervisor
         and Manager included, unless job_id.revision_open is
         momentarily True, which only airlogic.job.revision.action_approve
         sets (see that method). This is the actual "Completed visits
         lock" from the spec; a Supervisor fixing a value still has to go
         through the same Revision Request door as anyone else.

         perm_read is deliberately 0: this rule's domain excludes
         submitted-and-not-revision-open rows, so if it applied to reads
         too, those rows would go INVISIBLE the moment a job is
         submitted, not just unwritable (that was a real bug: AIR-T40's
         first cut had perm_read=1 here, and it made Inventory's
         checklist/reading list and the Equipment comparison tabs go
         blank for every submitted job). Only write/create are locked;
         read is always unrestricted by this rule. -->
    <!-- Manager gets an unconditional pass around the lock (AIR-T48):
         "user" is bound to the acting res.users record in domain_force's
         eval context, same as elsewhere in this file, so has_group() is
         safe to call here. Every write a Manager makes this way is
         logged to the job's chatter instead (see write() on
         airlogic.reading.line/airlogic.checklist.line), since there's
         no structured Revision record for this path. -->
    <record id="rule_reading_line_lock_submitted" model="ir.rule">
        <field name="name">Lock reading lines once Submitted (unless revision open or Manager)</field>
        <field name="model_id" ref="model_airlogic_reading_line"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('airlogic_core.group_airlogic_manager') else ['|', ('job_id.state', '!=', 'submitted'), ('job_id.revision_open', '=', True)]</field>
        <field name="perm_read">0</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_checklist_line_lock_submitted" model="ir.rule">
        <field name="name">Lock checklist lines once Submitted (unless revision open or Manager)</field>
        <field name="model_id" ref="model_airlogic_checklist_line"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('airlogic_core.group_airlogic_manager') else ['|', ('job_id.state', '!=', 'submitted'), ('job_id.revision_open', '=', True)]</field>
        <field name="perm_read">0</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_job_revision_technician_own" model="ir.rule">
        <field name="name">Technician: revision requests on own jobs only</field>
        <field name="model_id" ref="model_airlogic_job_revision"/>
        <field name="domain_force">[('job_id.technician_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('airlogic_core.group_airlogic_technician'))]"/>
    </record>

    <record id="rule_job_revision_supervisor_all" model="ir.rule">
        <field name="name">Operations Officer+: all revision requests</field>
        <field name="model_id" ref="model_airlogic_job_revision"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('airlogic_core.group_airlogic_supervisor'))]"/>
    </record>

    <record id="rule_part_request_technician_own" model="ir.rule">
        <field name="name">Technician: part requests on own jobs only</field>
        <field name="model_id" ref="model_airlogic_part_request"/>
        <field name="domain_force">[('job_id.technician_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('airlogic_core.group_airlogic_technician'))]"/>
    </record>

    <record id="rule_part_request_supervisor_all" model="ir.rule">
        <field name="name">Operations Officer+: all part requests</field>
        <field name="model_id" ref="model_airlogic_part_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('airlogic_core.group_airlogic_supervisor'))]"/>
    </record>

</odoo>
