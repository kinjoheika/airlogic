<?xml version="1.0" encoding="utf-8"?>
<!--
  Starting History Tags, seeded from the user's own examples. Editable/
  extendable under Configuration > History Tags. noupdate="1" so admin
  edits survive module upgrades.
-->
<odoo noupdate="1">
    <record id="history_tag_replaced_part" model="airlogic.history.tag">
        <field name="name">Replaced Part</field>
        <field name="keywords">replace, replaced, replacement, swapped</field>
        <field name="sequence">10</field>
    </record>
    <record id="history_tag_cleaned" model="airlogic.history.tag">
        <field name="name">Cleaned</field>
        <field name="keywords">cleaned, deep clean, descale, descaled</field>
        <field name="sequence">20</field>
    </record>
    <record id="history_tag_cannot_power_on" model="airlogic.history.tag">
        <field name="name">Cannot Power On</field>
        <field name="keywords">cannot power on, won't power on, no power, dead unit</field>
        <field name="sequence">30</field>
    </record>
</odoo>
