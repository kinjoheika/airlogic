<?xml version="1.0" encoding="utf-8"?>
<!--
  Manual fallback for hooks.py:seed_demo_service_history. post_init_hook
  only fires on a genuinely fresh module install, not a plain upgrade.
  If this branch's database persists across a push instead of resetting,
  the hook silently does nothing and the demo units stay without
  history. This gives a Manager a one-click way to run the same seeding
  function on demand instead. Safe to click more than once: the function
  itself no-ops if any job already exists for the demo units.
-->
<odoo>

    <record id="action_seed_demo_service_history" model="ir.actions.server">
        <field name="name">Re-seed Demo Service History</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">
from odoo.addons.airlogic_field_service.hooks import seed_demo_service_history
seed_demo_service_history(env)
        </field>
    </record>

</odoo>
