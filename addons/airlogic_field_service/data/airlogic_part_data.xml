<?xml version="1.0" encoding="utf-8"?>
<!--
  Requestable-part catalog shown in the mobile app's Request Parts
  section: Outdoor on Phase 2 (Power OFF), Indoor on Phase 3, both
  combined on Phase 4 as a final catch-all. noupdate="1" so a Manager
  editing/extending this list under Configuration survives upgrades.

  Migrated from the old airlogic.part model to real product.template
  records (AIR-T53/Phase 6.2), same xmlids, so Purchase's own vendor
  pricing (product.supplierinfo) becomes available per part. No vendor
  is seeded here: that's real-world data only the user has, added
  under each product's Purchase tab. default_code values below are
  placeholder model numbers, not real manufacturer part numbers.

  airlogic_equipment_category_ids is left unmapped: this addon's demo
  equipment categories (Split-Wall, Split-Floor, Window Type) don't
  have real per-category fitment data behind them yet, so the mobile
  app's Request Parts screen falls back to the full zone-filtered list
  for every unit until a Manager maps specific parts to specific
  categories under Configuration.
-->
<odoo noupdate="1">

    <record id="part_compressor" model="product.template">
        <field name="name">Compressor</field>
        <field name="type">consu</field>
        <field name="default_code">CMP-STD-01</field>
        <field name="airlogic_requestable">True</field>
        <field name="airlogic_zone">outdoor</field>
        <field name="sequence">10</field>
    </record>
