<?xml version="1.0" encoding="utf-8"?>
<!--
  Field Service is a launcher for the mobile app only. Service Jobs and
  Configuration (Measurement Fields, History Tags) live under Inventory's
  menu tree instead (see the parent="airlogic_core...." refs below): a
  Manager reviewing/configuring that data works from the desktop Inventory
  app, technicians in the field only ever want the mobile entry point.

  The root menuitem below carries the mobile action directly and has no
  child menu of its own, so opening Field Service goes straight into the
  app with no secondary menu bar to show first.
-->
<odoo>

    <menuitem id="menu_airlogic_field_service_root" name="Field Service" sequence="24"
              action="action_airlogic_mobile_field_entry"
              groups="airlogic_core.group_airlogic_technician"/>

    <!-- Both nested under Service Visit, not top-level under Inventory:
         a Job only exists as part of some Visit, and a Revision only
         exists to correct a Job. Reviewing either is a drill-down from
         Service Visit, not a peer of it. -->
    <menuitem id="menu_airlogic_service_job" name="Service Jobs"
              parent="airlogic_core.menu_airlogic_service_visit" action="action_airlogic_service_job"
              sequence="10"/>

    <!-- Sibling of Service Visits under Client Services, not nested
         under it: a contract generates visits, it isn't a drill-down
         from one specific visit the way Service Job/Revision Requests
         are. -->
    <menuitem id="menu_airlogic_service_contract" name="Subscription Contracts"
              parent="airlogic_core.menu_airlogic_client_services" action="action_airlogic_service_contract"
              groups="airlogic_core.group_airlogic_supervisor" sequence="10"/>

    <!-- Supervisor+ (not Configuration, which is Manager-only):
         reviewing requests/corrections is a day-to-day Supervisor task,
         not admin configuration. -->
    <menuitem id="menu_airlogic_job_revision" name="Revision Requests"
              parent="airlogic_core.menu_airlogic_service_visit" action="action_airlogic_job_revision"
              groups="airlogic_core.group_airlogic_supervisor" sequence="20"/>

    <!-- Sibling of Equipment under "Units", not nested inside it: part
         requests span every unit in a client's fleet, so this is a peer
         menu to review them all at once, not a per-equipment drill-down. -->
    <menuitem id="menu_airlogic_part_request" name="Part Requests"
              parent="airlogic_core.menu_airlogic_units" action="action_airlogic_part_request"
              groups="airlogic_core.group_airlogic_supervisor" sequence="10"/>

    <menuitem id="menu_airlogic_consumable_request" name="Consumable Requests"
              parent="airlogic_core.menu_airlogic_units" action="action_airlogic_consumable_request"
              groups="airlogic_core.group_airlogic_supervisor" sequence="20"/>

    <menuitem id="menu_airlogic_measurement_field" name="Measurement Fields"
              parent="airlogic_core.menu_airlogic_configuration" action="action_airlogic_measurement_field"
              sequence="60"/>

    <menuitem id="menu_airlogic_history_tag" name="History Tags"
              parent="airlogic_core.menu_airlogic_configuration" action="action_airlogic_history_tag"
              sequence="70"/>

    <menuitem id="menu_airlogic_part" name="Requestable Parts"
              parent="airlogic_core.menu_airlogic_configuration" action="action_airlogic_part"
              sequence="80"/>

    <menuitem id="menu_airlogic_consumable_product" name="Consumables"
              parent="airlogic_core.menu_airlogic_configuration" action="action_airlogic_consumable_product"
              sequence="82"/>

    <menuitem id="menu_airlogic_app_config" name="App Wallpaper"
              parent="airlogic_core.menu_airlogic_configuration" action="action_airlogic_app_config"
              sequence="85"/>

    <!-- Manual fallback for hooks.py:seed_demo_service_history. See
         data/airlogic_seed_action_data.xml for why this exists. -->
    <menuitem id="menu_seed_demo_service_history" name="Re-seed Demo Service History"
              parent="airlogic_core.menu_airlogic_configuration" action="action_seed_demo_service_history"
              groups="airlogic_core.group_airlogic_manager" sequence="99"/>

    <!-- See data/airlogic_seed_action_data.xml for what this generates. -->
    <menuitem id="menu_seed_stress_test_data" name="Seed Stress-Test Data (30 Visits)"
              parent="airlogic_core.menu_airlogic_configuration" action="action_seed_stress_test_data"
              groups="airlogic_core.group_airlogic_manager" sequence="100"/>

</odoo>
