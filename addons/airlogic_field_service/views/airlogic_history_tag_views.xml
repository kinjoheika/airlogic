<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration list for the History Tags that drive the mobile app's
  Unit History feed. Editable inline so a manager can tune what counts
  as a "major event" without touching code.
-->
<odoo>

    <record id="view_airlogic_history_tag_list" model="ir.ui.view">
        <field name="name">airlogic.history.tag.list</field>
        <field name="model">airlogic.history.tag</field>
        <field name="arch" type="xml">
            <list string="History Tags" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="keywords"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_airlogic_history_tag" model="ir.actions.act_window">
        <field name="name">History Tags</field>
        <field name="res_model">airlogic.history.tag</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a history tag</p>
            <p>A job shows up in the mobile app's Unit History only once
               its Service Visit has been approved by a Manager, and its
               notes or a flagged/alert checklist item's note match one
               of these keyword lists. Broader keywords surface more
               events; narrower ones fewer -- this is what keeps the
               feed to a handful of major events per year instead of
               every visit.</p>
        </field>
    </record>

</odoo>
