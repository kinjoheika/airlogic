<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_airlogic_service_job_list" model="ir.ui.view">
        <field name="name">airlogic.service.job.list</field>
        <field name="model">airlogic.service.job</field>
        <field name="arch" type="xml">
            <list string="Service Jobs">
                <field name="name"/>
                <field name="visit_id"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="equipment_id"/>
                <field name="technician_id"/>
                <field name="state" widget="badge" class="airlogic-badge" decoration-success="state == 'submitted'"/>
            </list>
        </field>
    </record>

    <record id="view_airlogic_service_job_form" model="ir.ui.view">
        <field name="name">airlogic.service.job.form</field>
        <field name="model">airlogic.service.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_visit" string="Start Visit" type="object"
                            class="oe_highlight airlogic-btn-primary" invisible="state != 'draft'"/>
                    <button name="action_submit" string="Submit" type="object"
                            class="oe_highlight airlogic-btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_request_revision" string="Request Correction" type="object"
                            invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="visit_id" readonly="visit_id != False"/>
                            <field name="equipment_id"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="technician_id"/>
                            <field name="date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Measurements" name="measurements">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <field name="fp_pdf_filename" invisible="1"/>
                                <field name="fp_pdf" filename="fp_pdf_filename"/>
                                <button name="action_import_fieldpiece_pdf"
                                        string="Import from PDF" type="object"
                                        class="btn-secondary" icon="fa-file-pdf-o"/>
                            </div>
                            <field name="reading_line_ids">
                                <list string="Measurements" editable="bottom" create="0" delete="0">
                                    <field name="section" readonly="1"/>
                                    <field name="field_id" readonly="1"/>
                                    <field name="value"/>
                                    <field name="unit" readonly="1"/>
                                    <field name="standard" readonly="1" string="Mfr. Standard"/>
                                </list>
                            </field>
                        </page>
                        <page string="Visual Checklist" name="visual_checklist">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <button name="action_open_visual_checklist" string="Open Visual Checklist"
                                        type="object" class="btn-secondary" icon="fa-check-square-o"/>
                            </div>
                            <field name="checklist_line_ids" readonly="1">
                                <list string="Visual Checklist" create="0" delete="0" edit="0">
                                    <field name="phase"/>
                                    <field name="label"/>
                                    <field name="value"/>
                                </list>
                            </field>
                        </page>
                        <page string="Photos &amp; Videos" name="media">
                            <!-- Only Supervisor+ can remove an attached file once
                                 uploaded (see write()/_check_no_media_removal on
                                 the model). These two fields show the SAME
                                 data, but only one renders per user: Odoo only
                                 keeps the element matching the viewer's groups. -->
                            <field name="media_ids" widget="many2many_binary"
                                   readonly="1" groups="!airlogic_core.group_airlogic_supervisor"/>
                            <field name="media_ids" widget="many2many_binary"
                                   groups="airlogic_core.group_airlogic_supervisor"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Technician notes for this visit..."/>
                        </page>
                        <page string="Part Requests" name="part_requests">
                            <field name="part_request_ids">
                                <list editable="bottom" create="0">
                                    <field name="part_id"/>
                                    <field name="requested_by" readonly="1"/>
                                    <field name="state" widget="badge" class="airlogic-badge"
                                           decoration-success="state == 'fulfilled'" decoration-info="state == 'approved'"
                                           decoration-danger="state == 'rejected'"/>
                                    <button name="action_approve" string="Approve" type="object"
                                            invisible="state != 'requested'" groups="airlogic_core.group_airlogic_supervisor"/>
                                    <button name="action_reject" string="Reject" type="object"
                                            invisible="state != 'requested'" groups="airlogic_core.group_airlogic_supervisor"/>
                                    <button name="action_fulfill" string="Fulfill" type="object"
                                            invisible="state != 'approved'" groups="airlogic_core.group_airlogic_supervisor"/>
                                </list>
                            </field>
                        </page>
                        <page string="Revisions" name="revisions">
                            <field name="revision_ids" readonly="1">
                                <list>
                                    <field name="create_date" string="Requested"/>
                                    <field name="field_label"/>
                                    <field name="old_value"/>
                                    <field name="new_value"/>
                                    <field name="reason"/>
                                    <field name="state" widget="badge" class="airlogic-badge"
                                           decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_airlogic_service_job_search" model="ir.ui.view">
        <field name="name">airlogic.service.job.search</field>
        <field name="model">airlogic.service.job</field>
        <field name="arch" type="xml">
            <search string="Service Jobs">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="equipment_id"/>
                <field name="technician_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state','=','in_progress')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <separator/>
                <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                <filter name="group_equipment" string="Equipment" context="{'group_by': 'equipment_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_airlogic_service_job" model="ir.actions.act_window">
        <field name="name">Service Jobs</field>
        <field name="res_model">airlogic.service.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_airlogic_service_job_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Log a service visit</p>
            <p>The 30 measurement rows auto-populate from Configuration &gt;
               Measurement Fields when you save a new job.</p>
        </field>
    </record>

</odoo>
