<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="airlogic_field_service.AirlogicClock">
        <span class="o_airlogic_nav_clock" t-esc="state.text"/>
    </t>

    <t t-name="airlogic_field_service.MobileFieldEntry">
        <div class="o_airlogic_mobile" t-att-style="state.wallpaperUrl ? 'background-image:url(' + state.wallpaperUrl + ')' : ''">
            <div class="o_airlogic_mobile_nav">
                <div class="o_airlogic_nav_exit" t-on-click="exitApp" title="Exit to Odoo">⌂</div>
                <div class="o_airlogic_mobile_brand">Standard <span>Airlogic</span></div>
                <div class="o_airlogic_nav_logout" t-on-click="requestLogout" title="Log Out">⏻</div>
                <AirlogicClock/>
                <div t-attf-class="o_airlogic_conn_badge {{state.online ? 'online' : 'offline'}}">
                    <t t-if="state.online">Online</t>
                    <t t-else="">Offline</t>
                    <t t-if="state.pendingCount"> · <t t-esc="state.pendingCount"/> pending</t>
                </div>
            </div>

            <!-- In-app toast, replaces Odoo's own notification service (see
                 setup()/showToast) so status messages like "Job submitted"
                 stay inside the phone frame instead of popping up over the
                 Odoo backend behind it. -->
            <div t-if="state.toast" t-attf-class="o_airlogic_toast o_airlogic_toast_{{state.toast.type}}">
                <t t-esc="state.toast.message"/>
            </div>

            <div t-if="state.loading" class="o_airlogic_mobile_loading">Loading…</div>

            <!-- PIN GATE 1 (before client list) -->
            <div t-if="state.screen === 'pin1' and !state.loading" class="o_airlogic_mobile_body o_airlogic_pin_screen">
                <div class="o_airlogic_pin_icon">🔐</div>
                <h4>Technician Verification</h4>
                <p class="text-muted">Enter your PIN to view clients.</p>
            </div>
            <div t-if="state.screen === 'pin1' and !state.loading" class="o_airlogic_footer_bar">
                <button type="button" class="btn airlogic-btn-primary" t-on-click="() => this.startPinCheck('clients')">
                    Continue
                </button>
            </div>

            <div t-if="state.screen === 'pin1_check' and !state.loading" class="o_airlogic_mobile_body o_airlogic_pin_screen">
                <div class="o_airlogic_pin_icon">🔐</div>
                <h4>Enter PIN</h4>
                <input type="password" inputmode="numeric" maxlength="6" class="form-control o_airlogic_pin_input"
                       t-att-value="state.pinInput" t-on-input="onPinInput" placeholder="• • • • • •"/>
                <p t-if="state.pinError" class="text-danger">Incorrect PIN. Try again.</p>
            </div>
            <div t-if="state.screen === 'pin1_check' and !state.loading" class="o_airlogic_footer_bar">
                <button type="button" class="btn btn-outline-secondary" t-on-click="cancelPin">Cancel</button>
                <button type="button" class="btn airlogic-btn-primary" t-on-click="confirmPin">Confirm</button>
            </div>

            <!-- CLIENT LIST (existing clients only, no client creation
                 in the mobile app) -->
            <div t-if="state.screen === 'clients' and !state.loading" class="o_airlogic_mobile_body">
                <h4>Select Client</h4>
                <div t-foreach="state.clients" t-as="client" t-key="client.id"
                     class="o_airlogic_card" t-on-click="() => this.selectClient(client)">
                    <div class="o_airlogic_card_title" t-esc="client.name"/>
                    <div class="o_airlogic_card_sub"><t t-esc="client.count"/> unit(s)</div>
                </div>
                <p t-if="!state.clients.length" class="text-muted">No clients on file yet.</p>
            </div>
            <div t-if="state.screen === 'clients' and !state.loading" class="o_airlogic_footer_bar">
                <button type="button" class="btn airlogic-btn-primary" t-on-click="openDispatchDirect">
                    🚚 Dispatch
                </button>
                <button type="button" class="btn btn-outline-secondary" t-on-click="openConsumables">
                    🧴 Consumables
                </button>
                <button type="button" class="btn btn-outline-secondary" t-on-click="openMyStatsDirect">
                    🏆 My Stats
                </button>
            </div>

            <!-- MAIN (bottom-nav tabs) -->
            <div t-if="state.screen === 'main' and !state.loading" class="o_airlogic_mobile_body o_airlogic_main">
                <div class="o_airlogic_title_row">
                    <span class="o_airlogic_back_arrow" t-on-click="backToClients" title="Back to Clients">‹</span>
                    <div class="o_airlogic_title_block">
                        <h4><t t-esc="state.selectedPartner ? state.selectedPartner.name : (state.tab === 'mystats' ? 'My Stats' : 'My Dispatch')"/></h4>
                        <div t-if="currentTabMeta" class="o_airlogic_tab_subtitle">
                            <t t-esc="currentTabMeta.icon"/> <t t-esc="currentTabMeta.label"/>
                        </div>
                    </div>
                </div>

                <!-- VISIT TAB -->
                <t t-if="state.tab === 'visit'">
                    <t t-foreach="state.devices" t-as="grp" t-key="grp.sublocation">
                        <div class="o_airlogic_group_hd" t-esc="grp.sublocation"/>
                        <div t-foreach="grp.items" t-as="device" t-key="device.id"
                             class="o_airlogic_card" t-on-click="() => this.selectDeviceForEntry(device)">
                            <div class="o_airlogic_card_title" t-esc="device.name"/>
                            <div class="o_airlogic_card_sub">
                                <t t-if="device.brand_id" t-esc="device.brand_id[1]"/>
                                <t t-if="device.model"> · <t t-esc="device.model"/></t>
                            </div>
                        </div>
                    </t>
                </t>

                <!-- DISPATCH TAB: "Upcoming" is this technician's own
                     confirmed-not-yet-fulfilled dispatch requests;
                     tapping one asks to fulfill it (see the confirm
                     dialog below). "Past" stays actual job history,
                     independent of the client this session started from. -->
                <t t-if="state.tab === 'dispatch'">
                    <div class="o_airlogic_group_hd">Upcoming</div>
                    <div t-foreach="state.dispatchUpcoming" t-as="d" t-key="d.id"
                         class="o_airlogic_card" t-on-click="() => this.openFulfillConfirm(d)">
                        <div class="o_airlogic_card_title">
                            <t t-esc="d.partner_id and d.partner_id[1] or d.name"/>
                            <span t-attf-class="o_airlogic_urgency_badge o_airlogic_urgency_{{d.urgency}}"
                                  t-esc="d.urgency"/>
                        </div>
                        <div class="o_airlogic_card_sub">
                            <t t-esc="d.equipment_id and d.equipment_id[1] or 'All units'"/>
                            <t t-if="d.suggested_date"> · <t t-esc="formatDispatchWhen(d.suggested_date)"/></t>
                        </div>
                    </div>
                    <p t-if="!state.dispatchUpcoming.length" class="text-muted">Nothing dispatched yet.</p>

                    <div class="o_airlogic_group_hd" style="margin-top:12px;">Past</div>
                    <div t-foreach="state.dispatchPast" t-as="j" t-key="j.id" class="o_airlogic_card">
                        <div class="o_airlogic_card_title" t-esc="j.partner_id and j.partner_id[1] or j.name"/>
                        <div class="o_airlogic_card_sub">
                            <t t-esc="j.equipment_id and j.equipment_id[1] or ''"/>
                            <t t-if="j.date"> · <t t-esc="j.date.slice(0, 10)"/></t>
                            <t t-if="j.state"> · <t t-esc="j.state"/></t>
                        </div>
                    </div>
                    <p t-if="!state.dispatchPast.length" class="text-muted">No past jobs yet.</p>
                </t>

                <!-- MY STATS TAB: one page, 5 positively-framed personal
                     numbers; no leaderboard against other technicians
                     (10 people is too small a pool for ranking to stay
                     motivating rather than discouraging), just each
                     technician's own progress. get_airlogic_my_stats
                     computes all of it fresh on open. -->
                <t t-if="state.tab === 'mystats' and state.myStats">
                    <div class="o_airlogic_streak_card">
                        <div class="o_airlogic_streak_flame">🔥</div>
                        <div class="o_airlogic_streak_value"><t t-esc="state.myStats.clean_streak"/></div>
                        <div class="o_airlogic_streak_label">Clean Jobs in a Row</div>
                        <div class="o_airlogic_streak_sub">No revisions requested against these yet</div>
                    </div>

                    <div class="o_airlogic_stats_grid">
                        <div class="o_airlogic_stat_tile">
                            <div class="o_airlogic_stat_value"><t t-esc="state.myStats.visits_made"/></div>
                            <div class="o_airlogic_stat_label">Visits Made</div>
                        </div>
                        <div class="o_airlogic_stat_tile">
                            <div class="o_airlogic_stat_value"><t t-esc="state.myStats.problems_resolved"/></div>
                            <div class="o_airlogic_stat_label">Problems Resolved</div>
                        </div>
                        <div class="o_airlogic_stat_tile">
                            <div class="o_airlogic_stat_value"><t t-esc="state.myStats.aircons_this_month"/></div>
                            <div class="o_airlogic_stat_label">Aircons This Month</div>
                        </div>
                        <div class="o_airlogic_stat_tile">
                            <div class="o_airlogic_stat_value"><t t-esc="state.myStats.aircons_this_year"/></div>
                            <div class="o_airlogic_stat_label">Aircons This Year</div>
                        </div>
                    </div>
                </t>

                <!-- UNITS TAB -->
                <t t-if="state.tab === 'units' and !state.unitEquipment">
                    <t t-foreach="state.devices" t-as="grp" t-key="grp.sublocation">
                        <div class="o_airlogic_group_hd" t-esc="grp.sublocation"/>
                        <div t-foreach="grp.items" t-as="device" t-key="device.id"
                             class="o_airlogic_card" t-on-click="() => this.openUnit(device)">
                            <div class="o_airlogic_card_title" t-esc="device.name"/>
                        </div>
                    </t>
                </t>
                <t t-if="state.tab === 'units' and state.unitEquipment">
                    <div class="o_airlogic_sticky_header">
                        <div class="o_airlogic_title_row">
                            <span class="o_airlogic_back_arrow" t-on-click="closeUnit" title="Back to Units">‹</span>
                            <h5 t-esc="state.unitEquipment.name"/>
                        </div>
                        <div class="o_airlogic_phase_bar">
                            <div t-attf-class="o_airlogic_phase_tab {{state.unitComparisonTab === 'reading' ? 'active' : ''}}"
                                 t-on-click="() => this.state.unitComparisonTab = 'reading'">Readings</div>
                            <div t-attf-class="o_airlogic_phase_tab {{state.unitComparisonTab === 'visual' ? 'active' : ''}}"
                                 t-on-click="() => this.state.unitComparisonTab = 'visual'">Visual Checklist</div>
                        </div>
                        <!-- Sub-badges: tapping one shows only that
                             section/phase below, nothing else stacked. -->
                        <div t-if="state.unitComparisonTab === 'reading'" class="o_airlogic_subphase_bar">
                            <div t-foreach="['Air Side', 'Refrigerant Side', 'Manometer Pressure']" t-as="sec" t-key="sec"
                                 t-attf-class="o_airlogic_subphase_tab {{state.unitReadingSection === sec ? 'active' : ''}}"
                                 t-on-click="() => this.state.unitReadingSection = sec">
                                <t t-esc="sec"/>
                            </div>
                        </div>
                        <div t-if="state.unitComparisonTab === 'visual'" class="o_airlogic_subphase_bar">
                            <div t-foreach="[1, 2, 3, 4]" t-as="ph" t-key="ph"
                                 t-attf-class="o_airlogic_subphase_tab {{state.unitChecklistPhase === ph ? 'active' : ''}}"
                                 t-on-click="() => this.state.unitChecklistPhase = ph">
                                Ph<t t-esc="ph"/>
                            </div>
                        </div>
                    </div>

                    <!-- Stacked cards, not a wide table: up to 3 past
                         visits per field/item, most recent first. -->
                    <t t-if="state.unitComparisonTab === 'reading'">
                        <p t-if="!currentReadingSection or !currentReadingSection.fields.length" class="text-muted">
                            No readings yet for this unit.
                        </p>
                        <div t-if="currentReadingSection" t-foreach="currentReadingSection.fields" t-as="f" t-key="f.name" class="o_airlogic_compare_card">
                            <div class="o_airlogic_compare_hd">
                                <span t-esc="f.name"/>
                                <span t-if="f.standard" class="o_airlogic_item_std"> (<t t-esc="f.standard"/>)</span>
                            </div>
                            <div t-foreach="f.values" t-as="v" t-key="v_index" class="o_airlogic_compare_row">
                                <span class="o_airlogic_compare_when"
                                      t-esc="(state.unitEquipment.readingData.job_headers[v_index] || {}).when || '—'"/>
                                <span class="o_airlogic_compare_val" t-esc="v"/>
                            </div>
                        </div>
                    </t>
                    <t t-if="state.unitComparisonTab === 'visual'">
                        <p t-if="!currentChecklistPhaseCompare or !currentChecklistPhaseCompare.items.length" class="text-muted">
                            No visual checklist entries yet for this unit.
                        </p>
                        <div t-if="currentChecklistPhaseCompare" t-foreach="currentChecklistPhaseCompare.items" t-as="it" t-key="it.label" class="o_airlogic_compare_card">
                            <div class="o_airlogic_compare_hd" t-esc="it.label"/>
                            <div t-foreach="it.values" t-as="v" t-key="v_index" class="o_airlogic_compare_row_wrap">
                                <div class="o_airlogic_compare_row">
                                    <span class="o_airlogic_compare_when"
                                          t-esc="(state.unitEquipment.visualData.job_headers[v_index] || {}).when || '—'"/>
                                    <span class="o_airlogic_compare_val" t-esc="v"/>
                                </div>
                                <div t-if="it.notes[v_index]" class="o_airlogic_compare_note" t-esc="it.notes[v_index]"/>
                            </div>
                        </div>
                    </t>
                </t>

                <!-- HISTORY TAB: same unit-per-sublocation picker as
                     Visit/Units, then that one unit's major-events feed -->
                <t t-if="state.tab === 'history' and !state.historyEquipment">
                    <t t-foreach="state.devices" t-as="grp" t-key="grp.sublocation">
                        <div class="o_airlogic_group_hd" t-esc="grp.sublocation"/>
                        <div t-foreach="grp.items" t-as="device" t-key="device.id"
                             class="o_airlogic_card" t-on-click="() => this.openHistoryUnit(device)">
                            <div class="o_airlogic_card_title" t-esc="device.name"/>
                        </div>
                    </t>
                </t>
                <t t-if="state.tab === 'history' and state.historyEquipment">
                    <div class="o_airlogic_sticky_header">
                        <div class="o_airlogic_title_row">
                            <span class="o_airlogic_back_arrow" t-on-click="closeHistoryUnit" title="Back to History">‹</span>
                            <h5 t-esc="state.historyEquipment.name"/>
                        </div>
                    </div>
                    <!-- Timeline layout (AIR-T48, chosen from 3 options):
                         a connecting rail + one colored dot per visit
                         (red/gold/teal for urgent/watch/routine, same
                         palette as Units and the Owner Report) reads as a
                         history at a glance and is the most compact of the
                         3 options shown. Not clickable: every detail is
                         already inline, there's nothing to open. -->
                    <div class="o_airlogic_timeline">
                        <div t-foreach="state.history" t-as="h" t-key="h.id" t-attf-class="o_airlogic_timeline_card {{h.severity}}">
                            <div class="o_airlogic_timeline_dot"/>
                            <div class="o_airlogic_timeline_head">
                                <span class="o_airlogic_timeline_ref" t-esc="h.name"/>
                                <span class="o_airlogic_timeline_when" t-esc="formatHistoryTimestamp(h.date)"/>
                            </div>
                            <div t-if="h.tagNames.length" class="o_airlogic_tag_row">
                                <span t-foreach="h.tagNames" t-as="tag" t-key="tag" class="o_airlogic_tag_badge" t-esc="tag"/>
                            </div>
                            <div t-foreach="h.parts" t-as="part" t-key="part_index" class="o_airlogic_timeline_line">
                                <b t-esc="part.label"/><t t-if="part.note"> — <t t-esc="part.note"/></t>
                            </div>
                            <div t-if="h.notes" class="o_airlogic_timeline_line" t-esc="h.notes"/>
                            <div class="o_airlogic_timeline_tech" t-esc="h.technician_id[1]"/>
                        </div>
                    </div>
                    <p t-if="!state.history.length" class="text-muted">
                        No major events yet for this unit -- jobs only show up here once their
                        Service Visit is approved by a Manager, and their notes match a History
                        Tag (Configuration &gt; History Tags).
                    </p>
                </t>

                <!-- EQUIPMENT (ADD/DELETE) TAB, only reachable after the
                     Senior Technician PIN gate (see setTab/confirmPin) -->
                <t t-if="state.tab === 'equipment' and !state.equipmentEdit">
                    <div class="o_airlogic_card o_airlogic_add_card" t-on-click="openNewEquipment">
                        <div class="o_airlogic_card_title">+ Add New Equipment</div>
                    </div>
                    <t t-foreach="state.devices" t-as="grp" t-key="grp.sublocation">
                        <div class="o_airlogic_group_hd" t-esc="grp.sublocation"/>
                        <div t-foreach="grp.items" t-as="device" t-key="device.id"
                             class="o_airlogic_card" t-on-click="() => this.openEquipmentEdit(device)">
                            <div class="o_airlogic_card_title" t-esc="device.name"/>
                        </div>
                    </t>
                </t>
                <t t-if="state.tab === 'equipment' and state.equipmentEdit">
                    <div class="o_airlogic_back" t-on-click="closeEquipmentEdit">‹ Equipment</div>
                    <div class="o_airlogic_item">
                        <div class="o_airlogic_item_label"><span>Unit Label</span></div>
                        <input type="text" class="form-control form-control-sm"
                               t-att-value="state.equipmentEdit.name"
                               t-on-change="(ev) => state.equipmentEdit.name = ev.target.value"/>
                    </div>
                    <div class="o_airlogic_item">
                        <div class="o_airlogic_item_label"><span>Model</span></div>
                        <input type="text" class="form-control form-control-sm"
                               t-att-value="state.equipmentEdit.model"
                               t-on-change="(ev) => state.equipmentEdit.model = ev.target.value"/>
                    </div>
                    <div class="o_airlogic_item">
                        <div class="o_airlogic_item_label"><span>Serial Number</span></div>
                        <input type="text" class="form-control form-control-sm"
                               t-att-value="state.equipmentEdit.serial_number"
                               t-on-change="(ev) => state.equipmentEdit.serial_number = ev.target.value"/>
                    </div>
                    <div class="o_airlogic_phase_nav">
                        <button type="button" class="btn airlogic-btn-primary" t-on-click="saveEquipmentEdit">
                            <t t-if="state.equipmentEdit.id">Save Equipment Info</t>
                            <t t-else="">Add Equipment</t>
                        </button>
                    </div>
                    <button t-if="state.equipmentEdit.id" type="button" class="btn btn-outline-danger w-100 mt-2 o_airlogic_btn_lg"
                            t-on-click="() => this.requestDeleteEquipment(state.equipmentEdit)">
                        🗑 Delete Equipment
                    </button>
                </t>
            </div>

            <!-- ORDER CONSUMABLES: not tied to a specific job/unit, so
                 its own small screen rather than living inside the DSR
                 flow (coil cleaner, insulation, copper tube, etc). -->
            <div t-if="state.screen === 'consumables' and !state.loading" class="o_airlogic_mobile_body">
                <div class="o_airlogic_title_row">
                    <span class="o_airlogic_back_arrow" t-on-click="closeConsumables" title="Back">‹</span>
                    <h4>Order Consumables</h4>
                </div>
                <p class="text-muted" style="font-size:13px;">
                    Each order creates a Purchase request right away -- no approval needed.
                </p>
                <div t-foreach="state.consumablesCatalog" t-as="c" t-key="c.id" class="o_airlogic_item">
                    <div class="o_airlogic_item_label">
                        <span t-esc="c.name"/>
                        <span t-if="c.default_code" class="o_airlogic_item_std" t-esc="c.default_code"/>
                    </div>
                    <div class="o_airlogic_item_control" style="gap:8px;">
                        <input type="number" step="0.1" min="0.1" class="form-control form-control-sm o_airlogic_number"
                               t-att-value="state.consumableQty[c.id] || ''"
                               t-on-change="(ev) => this.onConsumableQtyChange(c.id, ev)"/>
                        <button type="button" class="btn btn-sm airlogic-btn-primary"
                                t-on-click="() => this.orderConsumable(c.id)">Order</button>
                    </div>
                </div>
                <p t-if="!state.consumablesCatalog.length" class="text-muted">
                    No consumables configured yet (Configuration &gt; Consumables).
                </p>
            </div>

            <!-- BOTTOM NAV (5 tabs) -->
            <div t-if="state.screen === 'main' and !state.loading" class="o_airlogic_bottom_nav">
                <div t-attf-class="o_airlogic_bnav_tab {{state.tab === 'visit' ? 'active' : ''}}" t-on-click="() => this.setTab('visit')">
                    <div class="o_airlogic_bnav_icon">📋</div>Visit
                </div>
                <div t-attf-class="o_airlogic_bnav_tab {{state.tab === 'units' ? 'active' : ''}}" t-on-click="() => this.setTab('units')">
                    <div class="o_airlogic_bnav_icon">📊</div>Units
                </div>
                <div t-attf-class="o_airlogic_bnav_tab {{state.tab === 'history' ? 'active' : ''}}" t-on-click="() => this.setTab('history')">
                    <div class="o_airlogic_bnav_icon">🕐</div>History
                </div>
                <div t-if="state.currentTechnician and state.currentTechnician.isSenior"
                     t-attf-class="o_airlogic_bnav_tab {{state.tab === 'equipment' ? 'active' : ''}}" t-on-click="() => this.setTab('equipment')">
                    <div class="o_airlogic_bnav_icon">🔧</div>Add/Delete
                </div>
                <!-- Dispatch last (moved from its old 2nd position): the
                     tab a technician checks least often once they're
                     already mid-visit. -->
                <div t-attf-class="o_airlogic_bnav_tab {{state.tab === 'dispatch' ? 'active' : ''}}" t-on-click="() => this.setTab('dispatch')">
                    <div class="o_airlogic_bnav_icon">🚚</div>Dispatch
                </div>
            </div>

            <!-- DSR: DEVICE ENTRY, PHASES 1-4 -->
            <!-- (PIN GATE 2, before entering here, reuses the pin1_check
                 screen above with pinPurpose='device') -->
            <div t-if="state.screen === 'dsr' and state.job and !state.loading" class="o_airlogic_mobile_body">
                <div class="o_airlogic_sticky_header">
                    <h4><t t-esc="state.job.equipment_name"/> <small class="text-muted"><t t-esc="state.job.name"/></small></h4>
                    <div class="o_airlogic_phase_nav_dots">
                        <t t-foreach="checklistPhases" t-as="p" t-key="p.id">
                            <div t-attf-class="o_airlogic_phase_dot {{state.dsrPhase === p.id ? 'on' : ''}} {{p.id > unlockedPhase ? 'locked' : ''}}"
                                 t-on-click="() => this.goToPhase(p.id)">
                                <t t-if="p.id > unlockedPhase">🔒</t>
                                <t t-else=""><t t-esc="p.id"/></t>
                            </div>
                        </t>
                    </div>
                    <div class="text-muted" style="font-size:11px;"><t t-esc="currentDsrPhase.title"/></div>
                    <div t-if="syncWarning" class="o_airlogic_sync_warning">⚠ <t t-esc="syncWarning"/></div>
                </div>

                <t t-foreach="currentDsrPhase.items" t-as="item" t-key="item.key">
                    <div class="o_airlogic_item">
                        <div class="o_airlogic_item_label">
                            <span t-esc="item.label"/>
                            <span t-if="item.standard" class="o_airlogic_item_std" t-esc="item.standard"/>
                        </div>
                        <div class="o_airlogic_item_control">
                            <t t-if="item.type === 'check'">
                                <t t-set="line" t-value="checklistLine(item.key)"/>
                                <button type="button" class="btn btn-sm"
                                        t-att-class="(line and line.value === 'flagged') ? 'btn-danger' : (line and line.value === 'alert') ? 'btn-warning' : 'btn-outline-secondary'"
                                        t-on-click="() => this.openFlagDialog(item.key, item.label)">
                                    <t t-if="line and line.value === 'flagged'">⚠ Flagged</t>
                                    <t t-elif="line and line.value === 'alert'">⚡ Alert</t>
                                    <t t-else="">✓ Normal</t>
                                </button>
                            </t>
                            <t t-if="item.type === 'number'">
                                <input type="number" step="0.1" min="0" class="form-control form-control-sm o_airlogic_number"
                                       t-att-value="checklistLine(item.key) ? checklistLine(item.key).value : ''"
                                       t-on-change="(ev) => this.onNumberChecklistChange(item.key, ev)"/>
                                <span t-if="item.unit" class="o_airlogic_unit" t-esc="item.unit"/>
                            </t>
                            <t t-if="item.type === 'leak'">
                                <div style="width:100%;">
                                    <button type="button" class="btn btn-sm"
                                            t-att-class="!leakDetected ? 'btn-success' : 'btn-outline-secondary'"
                                            t-on-click="setLeakPass">✓ No Leak</button>
                                    <button type="button" class="btn btn-sm"
                                            t-att-class="leakDetected ? 'btn-danger' : 'btn-outline-secondary'"
                                            t-on-click="() => this.toggleLeakSpot(0)">⚠ Leak Detected</button>
                                    <div t-if="leakDetected" class="o_airlogic_leak_map">
                                        <t t-foreach="leakSpots" t-as="spot" t-key="spot.index">
                                            <div t-attf-class="o_airlogic_leak_spot {{leakSpotIndices.includes(spot.index) ? 'on' : ''}}"
                                                 t-on-click="() => this.toggleLeakSpot(spot.index)"
                                                 t-att-title="spot.zone">
                                                <t t-esc="spot.index + 1"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                            <t t-if="item.type === 'text'">
                                <textarea class="form-control form-control-sm"
                                          t-att-value="checklistLine(item.key) ? checklistLine(item.key).value : ''"
                                          t-on-change="(ev) => this.onNumberChecklistChange(item.key, ev)"/>
                            </t>
                        </div>
                    </div>
                </t>

                <!-- Ph4 also carries the PDF import + photos. The 30-field
                     Fieldpiece grid itself is no longer entered here. The
                     PDF import fills those same reading_line_ids directly,
                     and they're reviewable on the desktop Service Job form
                     or the Units tab's Readings comparison. -->
                <t t-if="state.dsrPhase === 4">
                    <div class="o_airlogic_group_hd">MeasureQuick / Fieldpiece Report</div>
                    <div class="o_airlogic_upload_zone">
                        <input type="file" accept="application/pdf" t-on-change="onPdfSelected"/>
                    </div>
                    <div class="o_airlogic_group_hd">Photos / Videos</div>
                    <div class="o_airlogic_upload_zone">
                        <input type="file" accept="image/*,video/*" multiple="multiple" t-on-change="onPhotoSelected"/>
                    </div>
                </t>

                <!-- Request Parts: bottom of Ph2 (Outdoor), Ph3 (Indoor),
                     Ph4 (both, final catch-all). currentPhaseParts is
                     empty on Ph1, so this whole block just doesn't show
                     there. -->
                <div t-if="currentPhaseParts.length" class="o_airlogic_parts_section">
                    <div class="o_airlogic_parts_toggle" t-on-click="() => this.togglePartsSection(state.dsrPhase)">
                        <span>🧰 Request Parts<t t-if="state.partRequests.length"> (<t t-esc="state.partRequests.length"/>)</t></span>
                        <span t-esc="state.partsExpanded[state.dsrPhase] ? '▲' : '▼'"/>
                    </div>
                    <div t-if="state.partsExpanded[state.dsrPhase]" class="o_airlogic_parts_list">
                        <label t-foreach="currentPhaseParts" t-as="part" t-key="part.id" class="o_airlogic_part_row">
                            <input type="checkbox" t-att-checked="findPartRequest(part.id) ? true : false"
                                   t-on-change="() => this.togglePartRequest(part.id)"/>
                            <span t-esc="part.name"/>
                            <span t-if="part.default_code" class="o_airlogic_item_std" t-esc="part.default_code"/>
                            <span t-if="findPartRequest(part.id) and findPartRequest(part.id).state !== 'requested'"
                                  t-attf-class="o_airlogic_part_state o_airlogic_part_state_{{findPartRequest(part.id).state}}"
                                  t-esc="findPartRequest(part.id).state"/>
                        </label>
                    </div>
                </div>
            </div>
            <div t-if="state.screen === 'dsr' and state.job and !state.loading" class="o_airlogic_footer_bar">
                <button type="button" class="btn btn-outline-secondary" t-on-click="requestExitDsr">‹ Back</button>
                <button type="button" class="btn btn-secondary" t-on-click="() => state.dsrPhase = Math.max(1, state.dsrPhase - 1)"
                        t-att-disabled="state.dsrPhase === 1">← Prev</button>
                <button t-if="state.dsrPhase &lt; 4" type="button" class="btn airlogic-btn-primary"
                        t-att-disabled="unlockedPhase &lt;= state.dsrPhase"
                        t-on-click="() => this.goToPhase(state.dsrPhase + 1)">Save &amp; Next →</button>
                <button t-else="" type="button" class="btn airlogic-btn-invoice" t-on-click="onSubmitJob">
                    Submit
                </button>
            </div>

            <!-- FLAG / ALERT DIALOG -->
            <div t-if="state.flagDialog" class="o_airlogic_dialog_overlay">
                <div class="o_airlogic_dialog_sheet">
                    <div class="o_airlogic_dialog_hd">Mark Issue</div>
                    <div class="o_airlogic_dialog_item" t-esc="state.flagDialog.label"/>
                    <textarea class="form-control" placeholder="Add note (optional)…" rows="3"
                              t-att-value="state.flagDialog.note" t-on-change="onFlagNoteChange"/>
                    <div class="o_airlogic_dialog_choices">
                        <button type="button" class="btn btn-warning" t-on-click="() => this.setFlagState('alert')">⚡ Alert</button>
                        <button type="button" class="btn btn-danger" t-on-click="() => this.setFlagState('flagged')">⚠ Flagged</button>
                    </div>
                    <button type="button" class="btn btn-outline-secondary w-100 mt-2" t-on-click="setNormal">✓ Set Normal</button>
                    <button type="button" class="btn btn-link w-100" t-on-click="cancelFlagDialog">Cancel</button>
                </div>
            </div>

            <!-- DELETE EQUIPMENT CONFIRM DIALOG -->
            <div t-if="state.deleteConfirmDevice" class="o_airlogic_dialog_overlay">
                <div class="o_airlogic_dialog_sheet text-center">
                    <div style="font-size:28px;">🗑</div>
                    <div class="o_airlogic_dialog_hd">Delete Equipment?</div>
                    <p class="text-muted">
                        Remove <t t-esc="state.deleteConfirmDevice.name"/>? Units with existing
                        service history are protected and can't be deleted here — ask a Manager
                        to remove those from Inventory instead.
                    </p>
                    <button type="button" class="btn btn-danger w-100 mb-2" t-on-click="confirmDeleteEquipment">Delete</button>
                    <button type="button" class="btn btn-outline-secondary w-100" t-on-click="cancelDeleteEquipment">Cancel</button>
                </div>
            </div>

            <!-- EXIT-CONFIRM DIALOG -->
            <div t-if="state.exitConfirm" class="o_airlogic_dialog_overlay">
                <div class="o_airlogic_dialog_sheet text-center">
                    <div style="font-size:28px;">💾</div>
                    <div class="o_airlogic_dialog_hd">Exit Service Entry?</div>
                    <p class="text-muted">
                        <t t-if="state.pendingCount">You have <t t-esc="state.pendingCount"/> unsynced change(s). </t>
                        Make sure your work is saved before leaving.
                    </p>
                    <button type="button" class="btn airlogic-btn-primary w-100 mb-2" t-on-click="stayInDsr">Stay</button>
                    <button type="button" class="btn btn-outline-secondary w-100" t-on-click="confirmExitDsr">Exit</button>
                </div>
            </div>

            <!-- LOGOUT-CONFIRM DIALOG -->
            <div t-if="state.logoutConfirm" class="o_airlogic_dialog_overlay">
                <div class="o_airlogic_dialog_sheet text-center">
                    <div style="font-size:28px;">⏻</div>
                    <div class="o_airlogic_dialog_hd">Log Out?</div>
                    <p class="text-muted">
                        You'll be sent back to PIN entry. Any unsynced changes stay saved
                        on this device and sync once you're back online.
                    </p>
                    <button type="button" class="btn btn-danger w-100 mb-2" t-on-click="confirmLogout">Log Out</button>
                    <button type="button" class="btn btn-outline-secondary w-100" t-on-click="cancelLogoutConfirm">Cancel</button>
                </div>
            </div>

            <!-- FULFILL DISPATCH CONFIRM DIALOG -->
            <div t-if="state.fulfillConfirm" class="o_airlogic_dialog_overlay">
                <div class="o_airlogic_dialog_sheet text-center">
                    <div style="font-size:28px;">🚚</div>
                    <div class="o_airlogic_dialog_hd">Fulfill this dispatch?</div>
                    <p class="text-muted">
                        <t t-esc="state.fulfillConfirm.partner_id and state.fulfillConfirm.partner_id[1] or ''"/>
                        <t t-if="state.fulfillConfirm.suggested_date">
                            — <t t-esc="formatDispatchWhen(state.fulfillConfirm.suggested_date)"/>
                        </t>. You'll go to their Visit page to create the Service Job.
                    </p>
                    <button type="button" class="btn airlogic-btn-primary w-100 mb-2" t-on-click="confirmFulfillYes">Yes</button>
                    <button type="button" class="btn btn-outline-secondary w-100" t-on-click="cancelFulfillConfirm">No</button>
                </div>
            </div>
        </div>
    </t>

</templates>
