<?xml version="1.0" encoding="utf-8"?>
<!--
  Two compact, reference-only Site Visit reports (AIR-T56), distinct
  from the full Owner Full Report, Option A: both are meant to be
  quick, professional printouts linked back to the Service Visit
  (header shows the SRV- number) and each unit's Service Job (each row
  shows its SVJ- number), not the client-facing formal document the
  Owner Report is.

  Report A (Simple): status only, no reading numbers, one line per
  unit: the most compressed version.
  Report B (With Readings): same, plus each unit's "main numbers"
  (Phase 1 vitals + anything out of range), see
  models/airlogic_site_visit_report.py's VITAL_CODES for exactly which.

  Both share the same header and a photo appendix (1.4in x 2.49in
  portrait tiles, 9:16 like a phone camera photo, headed per unit,
  e.g. "AC Unit 1 - Reception Lobby, Reception Lobby ·
  SVJ-2026-0041"), placed right before the final page. Report A has
  no last page at all. Report B's is a Standard Reference table (from
  Configuration > Measurement Fields), one column per unit on the
  visit, each column showing that field's standard value: it reads
  the visit only for which units to list as columns, never for their
  actual measured data, so the numbers themselves never vary per
  visit.

  Reuses paperformat_airlogic_owner_report (see
  data/airlogic_report_paperformat_data.xml) and the same
  web.basic_layout + Bootstrap .container override as the Owner
  Report (see that template's own header comment, AIR-T50): same
  root cause would otherwise bite here too.
-->
<odoo>

    <!-- ============== Shared sub-templates ============== -->

    <template id="site_visit_report_style_fix">
        <style>
            body.container { max-width: none !important; width: 100% !important; margin: 0 !important; padding: 0 !important; }
        </style>
    </template>

    <template id="site_visit_report_header">
        <div style="page-break-inside:avoid;">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <h3 style="font-weight:800;font-size:15px;">Standard Airlogic <small class="text-muted">Service Co.</small></h3>
                    <div class="text-muted" style="font-size:11px;" t-esc="report_subtitle"/>
                </div>
                <div class="text-end" style="font-size:11px;">
                    Visit No. <span t-esc="visit.name"/><br/>
                    Service Visit Date: <span t-esc="visit.date and visit.date.strftime('%B %d, %Y') or ''"/><br/>
                    Technician: <span t-esc="visit.technician_id.name"/><br/>
                    Reviewer: <span t-esc="visit.reviewed_by_id.name or '—'"/>
                </div>
            </div>
            <hr/>
            <div class="row mb-3" style="font-size:11px;">
                <div class="col-4">
                    <div class="text-muted text-uppercase" style="font-size:8.5px;">Client</div>
                    <div class="fw-bold" t-esc="visit.partner_id.display_name"/>
                </div>
                <div class="col-4">
                    <div class="text-muted text-uppercase" style="font-size:8.5px;">Units Inspected</div>
                    <div class="fw-bold"><t t-esc="vd['total']"/> unit(s)</div>
                </div>
            </div>
        </div>
    </template>

    <!-- Photos headed per unit (not one undifferentiated pool), still
         collected together as an appendix rather than scattered inline
         in the compact per-unit summary above: 1.4in x 2.49in portrait
         tiles, a 9:16 ratio matching how a phone camera actually
         frames a photo, per the user's spec. -->
    <template id="site_visit_report_photos">
        <div t-if="vd['has_photos']" style="page-break-before:always;">
            <h5 style="font-weight:800;font-size:13px;margin-bottom:10px;">Site Photos</h5>
            <t t-foreach="vd['jobs_info']" t-as="ji">
                <div t-if="ji['photos']" style="margin-bottom:14px;page-break-inside:avoid;">
                    <div style="font-size:11px;font-weight:700;margin-bottom:6px;">
                        <t t-esc="ji['job'].equipment_id.name"/> — <t t-esc="ji['job'].equipment_id.sublocation_id.name or 'No sublocation'"/> · <t t-esc="ji['job'].name"/>
                    </div>
                    <div style="display:flex;flex-wrap:wrap;gap:10px;">
                        <img t-foreach="ji['photos']" t-as="photo"
                             t-attf-src="data:{{photo.mimetype}};base64,{{photo.datas.decode()}}"
                             style="width:1.4in;height:2.49in;object-fit:cover;border:1px solid #ddd;border-radius:3px;"/>
                    </div>
                </div>
            </t>
        </div>
    </template>

    <!-- ============== Report A: Simple (status only) ============== -->

    <template id="report_svr_simple">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="visit">
                <t t-set="vd" t-value="visit_data[visit.id]"/>
                <t t-set="report_subtitle">Air Handling Unit — Site Visit Report (Simple)</t>
                <t t-call="web.basic_layout">
                    <t t-call="airlogic_field_service.site_visit_report_style_fix"/>
                    <div class="page">
                        <t t-call="airlogic_field_service.site_visit_report_header"/>

                        <h5 style="font-weight:800;font-size:13px;margin-bottom:8px;">Unit-by-Unit Summary</h5>
                        <table style="width:100%;font-size:10px;border-collapse:collapse;">
                            <thead>
                                <tr style="border-bottom:1.5px solid #212529;">
                                    <th style="text-align:left;padding:5px 6px;">Unit</th>
                                    <th style="text-align:left;padding:5px 6px;">Job No.</th>
                                    <th style="text-align:left;padding:5px 6px;">Status</th>
                                    <th style="text-align:left;padding:5px 6px;">Issues</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="vd['jobs_info']" t-as="ji">
                                    <t t-set="text_class" t-value="{'good': 'text-success', 'watch': 'text-warning', 'urgent': 'text-danger'}[ji['status']]"/>
                                    <t t-set="status_label" t-value="{'good': 'GOOD', 'watch': 'WATCH', 'urgent': 'URGENT'}[ji['status']]"/>
                                    <tr style="border-bottom:1px solid #eee;page-break-inside:avoid;">
                                        <td style="padding:5px 6px;">
                                            <strong t-esc="ji['job'].equipment_id.name"/>
                                            <div class="text-muted" style="font-size:9px;" t-esc="ji['job'].equipment_id.sublocation_id.name or ''"/>
                                        </td>
                                        <td style="padding:5px 6px;" t-esc="ji['job'].name"/>
                                        <td style="padding:5px 6px;">
                                            <span t-attf-class="fw-bold {{text_class}}" t-esc="status_label"/>
                                        </td>
                                        <td style="padding:5px 6px;">
                                            <span t-if="not ji['issues']" class="text-success">Clear</span>
                                            <t t-foreach="ji['issues']" t-as="issue" t-key="issue_index">
                                                <span t-esc="issue['label']"/><t t-if="not issue_last">, </t>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <t t-call="airlogic_field_service.site_visit_report_photos"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_svr_simple" model="ir.actions.report">
        <field name="name">Site Visit Report — Simple</field>
        <field name="model">airlogic.service.visit</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">airlogic_field_service.report_svr_simple</field>
        <field name="report_file">airlogic_field_service.report_svr_simple</field>
        <field name="print_report_name">'StandardAir_Site Visit Simple_%s_%s' % (object.partner_id.name, object.date and object.date.strftime('%Y-%m-%d') or '')</field>
        <field name="paperformat_id" ref="paperformat_airlogic_owner_report"/>
        <field name="binding_model_id" ref="airlogic_core.model_airlogic_service_visit"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ============== Report B: With Readings ============== -->

    <template id="report_svr_readings">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="visit">
                <t t-set="vd" t-value="visit_data[visit.id]"/>
                <t t-set="report_subtitle">Air Handling Unit — Site Visit Report (With Readings)</t>
                <t t-call="web.basic_layout">
                    <t t-call="airlogic_field_service.site_visit_report_style_fix"/>
                    <div class="page">
                        <t t-call="airlogic_field_service.site_visit_report_header"/>

                        <h5 style="font-weight:800;font-size:13px;margin-bottom:8px;">Unit-by-Unit Summary</h5>
                        <t t-foreach="vd['jobs_info']" t-as="ji">
                            <t t-set="text_class" t-value="{'good': 'text-success', 'watch': 'text-warning', 'urgent': 'text-danger'}[ji['status']]"/>
                            <t t-set="status_label" t-value="{'good': 'GOOD', 'watch': 'WATCH', 'urgent': 'URGENT'}[ji['status']]"/>
                            <div style="border:1px solid #dee2e6;border-radius:5px;padding:8px 10px;margin-bottom:8px;page-break-inside:avoid;">
                                <div class="d-flex justify-content-between align-items-center" style="font-size:11px;">
                                    <div>
                                        <strong t-esc="ji['job'].equipment_id.name"/>
                                        <span class="text-muted"> — <t t-esc="ji['job'].equipment_id.sublocation_id.name or 'No sublocation'"/></span>
                                        <span class="text-muted"> · <t t-esc="ji['job'].name"/></span>
                                    </div>
                                    <span t-attf-class="fw-bold {{text_class}}" t-esc="status_label"/>
                                </div>
                                <div style="font-size:10px;margin-top:4px;">
                                    <span t-if="not ji['issues']" class="text-success">Clear — no repairs needed.</span>
                                    <t t-foreach="ji['issues']" t-as="issue" t-key="issue_index">
                                        <span t-attf-class="{{issue['severity'] == 'flagged' and 'text-danger' or 'text-warning'}} fw-bold" t-esc="issue['label']"/><t t-if="not issue_last">, </t>
                                    </t>
                                </div>
                            </div>
                        </t>

                        <!-- Field x Unit readings matrix, styled to
                             match the Standard Reference table on the
                             last page cell-for-cell (same padding, font
                             size, border weight) so the two line up
                             when flipping between "what we measured"
                             and "what's normal" for the same field row. -->
                        <h5 style="font-weight:800;font-size:13px;margin:14px 0 4px;">Readings</h5>
                        <table style="width:100%;font-size:10px;border-collapse:collapse;">
                            <thead>
                                <tr style="border-bottom:1.5px solid #212529;">
                                    <th style="text-align:left;padding:4px 6px;">Field</th>
                                    <th t-foreach="vd['jobs_info']" t-as="u" t-key="u['job'].id"
                                        style="text-align:left;padding:4px 6px;" t-esc="u['job'].equipment_id.name"/>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="standards" t-as="f" t-key="f.id" style="border-bottom:1px solid #eee;">
                                    <td style="padding:4px 6px;" t-esc="f.name"/>
                                    <t t-foreach="vd['jobs_info']" t-as="u" t-key="u['job'].id">
                                        <t t-set="cell" t-value="vd['reading_matrix'].get((f.id, u['job'].id))"/>
                                        <td style="padding:4px 6px;">
                                            <span t-if="cell" t-attf-class="{{cell['out_of_range'] and 'text-danger fw-bold' or ''}}" t-esc="cell['value']"/>
                                            <span t-else="" class="text-muted">—</span>
                                        </td>
                                    </t>
                                </tr>
                            </tbody>
                        </table>

                        <t t-call="airlogic_field_service.site_visit_report_photos"/>

                        <!-- One column per unit on this visit, each
                             showing that field's Configuration-set
                             standard: units are read from vd only to
                             label the columns, the standard value
                             itself is identical in every column, since
                             it's not unit-specific data. Same padding/
                             font-size/border as the Readings table
                             above, on purpose (AIR-T58): same row set,
                             same row order, same spacing, so the two
                             tables line up when comparing this visit's
                             numbers against what's normal. -->
                        <div style="page-break-before:always;">
                            <h5 style="font-weight:800;font-size:13px;margin-bottom:4px;">Standard Reference Values</h5>
                            <div class="text-muted mb-2" style="font-size:9px;">
                                Manufacturer/standard ranges configured under Configuration &gt; Measurement Fields,
                                listed per unit for easy side-by-side reference.
                            </div>
                            <table style="width:100%;font-size:10px;border-collapse:collapse;">
                                <thead>
                                    <tr style="border-bottom:1.5px solid #212529;">
                                        <th style="text-align:left;padding:4px 6px;">Field</th>
                                        <th t-foreach="vd['jobs_info']" t-as="u" t-key="u['job'].id"
                                            style="text-align:left;padding:4px 6px;" t-esc="u['job'].equipment_id.name"/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="standards" t-as="f" t-key="f.id" style="border-bottom:1px solid #eee;">
                                        <td style="padding:4px 6px;" t-esc="f.name"/>
                                        <td t-foreach="vd['jobs_info']" t-as="u" t-key="u['job'].id"
                                            style="padding:4px 6px;" t-esc="f.standard"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_svr_readings" model="ir.actions.report">
        <field name="name">Site Visit Report — With Readings</field>
        <field name="model">airlogic.service.visit</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">airlogic_field_service.report_svr_readings</field>
        <field name="report_file">airlogic_field_service.report_svr_readings</field>
        <field name="print_report_name">'StandardAir_Site Visit Readings_%s_%s' % (object.partner_id.name, object.date and object.date.strftime('%Y-%m-%d') or '')</field>
        <field name="paperformat_id" ref="paperformat_airlogic_owner_report"/>
        <field name="binding_model_id" ref="airlogic_core.model_airlogic_service_visit"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
