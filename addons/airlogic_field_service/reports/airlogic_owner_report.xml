<?xml version="1.0" encoding="utf-8"?>
<!--
  Owner Full Report, Option A: ported from the aircon-service-ui
  mockup's finalized/chosen PDF template (tab-pdfview, id="pdf-oa").

  Deliberately omitted vs. the mockup, since this addon doesn't track
  the underlying data for them:
    - Section 2's SVG system-diagram + parts A-G legend (static
      illustrative content, not per-record data)
    - Repair cost estimates (no cost/pricing-per-issue field exists)
    - "Contract type" / "Next Service" in the header bar (no contract
      or scheduling model exists yet)
  Per-unit status (Good/Watch/Urgent) and Issues Found are derived from
  real checklist data (airlogic.service.visit._job_status/_job_issues),
  not fabricated, and site photos are the job's real media_ids. Each
  Issue Found now carries the technician's actual note text (not just
  the item label), and each unit card shows the job's general
  Technician Notes too, if any were written (AIR-T45).

  Layout finalized against a stakeholder-reviewed preview (AIR-T47):
  Section 1 is boxed as its own visual block; the Status fact was
  dropped as redundant with the state already visible everywhere else
  the report is opened from; "Reviewer" (visit.reviewed_by_id, set by
  action_approve()) sits in the header next to Technician instead of a
  blank signature line, since a Manager approval is what unlocks the
  report/History visibility in the first place, and there is no
  separate physical sign-off step; issue notes sit inline beside their
  label instead of stacked, to save vertical space on units with
  several issues.

  Uses web.basic_layout, not web.external_layout: this template already
  builds its own header/footer (see below), so wrapping it in Odoo's
  company letterhead template would add the company's configurable
  Document Layout (style/colors/logo, set under Settings) on top. The
  report is meant to print exactly the same regardless of that setting.

  Multi-page visits (AIR-T48): "page-break-inside:avoid" on the header
  block, the Section 1 box, and every unit card keeps each of those from
  being awkwardly split mid-block if a visit's unit list runs onto a
  second printed page, a plain CSS property wkhtmltopdf honors
  natively. True *repeating* header/footer content on every physical
  page (not just protecting these blocks from splitting) needs a
  dedicated report.paperformat with header/footer margins and either
  web.external_layout or position:fixed content sized to fit inside
  those margins; that is a bigger, harder-to-verify change than this
  pass makes, since it can't be checked without a live render.

  Unit cards are laid out image-left/notes-right (not stacked) and
  capped at 2 thumbnails, so more units fit per printed page.

  Content floating in the center of the page (AIR-T50): web.basic_layout
  (Odoo's own template, not ours) wraps everything in a body carrying
  Bootstrap's .container class, and .container sets a max-width plus
  margin:0 auto: exactly the "centered column with a fixed max width"
  behavior a normal web page wants, and exactly wrong for a document
  meant to fill the page edge-to-edge. web.external_layout doesn't have
  this problem (it overrides .container's own styling), but this
  template intentionally doesn't use it (see the note above about
  Document Layout). The style block right below neutralizes just that
  one Bootstrap rule so .page actually starts at the true top-left of
  the page instead of floating in a centered box.
-->
<odoo>

    <template id="report_airlogic_owner_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="visit">
                <t t-set="vd" t-value="visit_data[visit.id]"/>
                <t t-call="web.basic_layout">
                    <style>
                        body.container { max-width: none !important; width: 100% !important; margin: 0 !important; padding: 0 !important; }
                    </style>
                    <div class="page">
                        <div style="page-break-inside:avoid;">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h3 style="font-weight:800;">Standard Airlogic <small class="text-muted">Service Co.</small></h3>
                                    <div class="text-muted" style="font-size:11px;">Air Handling Unit — Owner Service Report</div>
                                </div>
                                <div class="text-end" style="font-size:11px;">
                                    Report No. <span t-esc="visit.name"/><br/>
                                    Service Visit Date: <span t-esc="visit.date and visit.date.strftime('%B %d, %Y') or ''"/><br/>
                                    Technician: <span t-esc="visit.technician_id.name"/><br/>
                                    Reviewer: <span t-esc="visit.reviewed_by_id.name or '—'"/>
                                </div>
                            </div>
                            <hr/>
                        </div>

                        <div class="row mb-3" style="font-size:11px;">
                            <div class="col-4">
                                <div class="text-muted text-uppercase" style="font-size:9px;">Client</div>
                                <div class="fw-bold" t-esc="visit.partner_id.display_name"/>
                            </div>
                            <div class="col-4">
                                <div class="text-muted text-uppercase" style="font-size:9px;">Units Inspected</div>
                                <div class="fw-bold"><t t-esc="vd['total']"/> unit(s)</div>
                            </div>
                        </div>

                        <div style="border:2px solid #212529;border-radius:6px;padding:14px 16px 4px;margin-bottom:22px;page-break-inside:avoid;">
                            <h5 style="font-weight:800;margin-bottom:14px;"><span class="badge bg-dark">1</span> Assets Status — This Visit</h5>
                            <div class="row text-center mb-2">
                                <div class="col-4">
                                    <div class="text-success" style="font-size:20px;font-weight:800;">
                                        <t t-esc="vd['counts']['good']"/> <small class="text-muted">/ <t t-esc="vd['total']"/></small>
                                    </div>
                                    <div class="text-muted" style="font-size:10px;">Good Condition</div>
                                </div>
                                <div class="col-4">
                                    <div class="text-warning" style="font-size:20px;font-weight:800;">
                                        <t t-esc="vd['counts']['watch']"/> <small class="text-muted">/ <t t-esc="vd['total']"/></small>
                                    </div>
                                    <div class="text-muted" style="font-size:10px;">Requires Watch</div>
                                </div>
                                <div class="col-4">
                                    <div class="text-danger" style="font-size:20px;font-weight:800;">
                                        <t t-esc="vd['counts']['urgent']"/> <small class="text-muted">/ <t t-esc="vd['total']"/></small>
                                    </div>
                                    <div class="text-muted" style="font-size:10px;">Urgent Action</div>
                                </div>
                            </div>
                        </div>

                        <h5 style="font-weight:800;"><span class="badge bg-dark">2</span> Unit-by-Unit Detail</h5>
                        <t t-foreach="vd['jobs_info']" t-as="ji">
                            <t t-set="border_class" t-value="{'good': 'border-success', 'watch': 'border-warning', 'urgent': 'border-danger'}[ji['status']]"/>
                            <t t-set="text_class" t-value="{'good': 'text-success', 'watch': 'text-warning', 'urgent': 'text-danger'}[ji['status']]"/>
                            <t t-set="status_label" t-value="{'good': 'GOOD', 'watch': 'WATCH', 'urgent': 'URGENT'}[ji['status']]"/>
                            <div t-attf-class="card mb-2 {{border_class}}" style="border-width:2px;page-break-inside:avoid;">
                                <div class="card-header d-flex justify-content-between align-items-center py-1">
                                    <div>
                                        <strong t-esc="ji['job'].equipment_id.name"/>
                                        <span class="text-muted"> — <t t-esc="ji['job'].equipment_id.sublocation_id.name or 'No sublocation'"/></span>
                                    </div>
                                    <span t-attf-class="fw-bold {{text_class}}" t-esc="status_label"/>
                                </div>
                                <!-- Image-left / notes-right, not stacked, and the
                                     notes column is height-capped: keeps each card
                                     compact enough to fit ~4-5 per printed page
                                     even on units with a long note. -->
                                <div class="card-body py-2" style="display:flex;gap:10px;">
                                    <div t-if="ji['photos']" style="flex:0 0 auto;display:flex;flex-direction:column;gap:4px;">
                                        <img t-foreach="ji['photos'][:2]" t-as="photo"
                                             t-attf-src="data:{{photo.mimetype}};base64,{{photo.datas.decode()}}"
                                             style="width:60px;height:60px;object-fit:cover;border:1px solid #ddd;border-radius:3px;"/>
                                        <div t-if="len(ji['photos']) > 2" class="text-muted text-center" style="font-size:8px;">
                                            +<t t-esc="len(ji['photos']) - 2"/> more
                                        </div>
                                    </div>
                                    <div style="flex:1 1 auto;min-width:0;max-height:92px;overflow:hidden;">
                                        <div t-if="ji['issues']">
                                            <div class="text-muted text-uppercase" style="font-size:8.5px;">Issues Found</div>
                                            <ul style="font-size:10px;margin-bottom:0;padding-left:14px;">
                                                <li t-foreach="ji['issues']" t-as="issue">
                                                    <span t-attf-class="fw-bold {{issue['severity'] == 'flagged' and 'text-danger' or 'text-warning'}}"
                                                          t-esc="issue['label']"/>
                                                    <span t-if="issue['note']" class="text-muted" style="font-size:9px;"> — <t t-esc="issue['note']"/></span>
                                                </li>
                                            </ul>
                                        </div>
                                        <div t-else="" class="text-success" style="font-size:10px;">
                                            ✓ All checklist items clear — no repairs needed.
                                        </div>
                                        <div t-if="ji['job'].notes" style="font-size:9px;color:#6c757d;margin-top:3px;">
                                            <b>Notes:</b> <t t-esc="ji['job'].notes"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <div class="text-center mt-4 pt-2"
                             style="border-top:1px solid #E7E9EB;font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#6c757d;page-break-inside:avoid;">
                            — End Report —
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_airlogic_owner_report" model="ir.actions.report">
        <field name="name">Owner Full Report — Option A</field>
        <field name="model">airlogic.service.visit</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">airlogic_field_service.report_airlogic_owner_report</field>
        <field name="report_file">airlogic_field_service.report_airlogic_owner_report</field>
        <field name="print_report_name">'StandardAir_Field Service Report_%s_%s' % (object.partner_id.name, object.date and object.date.strftime('%Y-%m-%d') or '')</field>
        <field name="binding_model_id" ref="airlogic_core.model_airlogic_service_visit"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
