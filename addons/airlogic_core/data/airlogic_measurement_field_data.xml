<?xml version="1.0" encoding="utf-8"?>
<!--
  Seed for the Fieldpiece JobLink 30-field measurement tool, ported from
  the aircon-service-ui mockup's FIELDPIECE_FIELDS JS config. noupdate="1"
  so admin edits made from Configuration > Measurement Fields survive
  module upgrades.
-->
<odoo noupdate="1">

    <!-- Air Side -->
    <record id="mf_return_air_db" model="airlogic.measurement.field">
        <field name="code">return_air_db</field>
        <field name="name">Return Air Dry Bulb</field>
        <field name="section">Air Side</field>
        <field name="unit">°C</field>
        <field name="sequence">10</field>
    </record>
    <record id="mf_supply_air_db" model="airlogic.measurement.field">
        <field name="code">supply_air_db</field>
        <field name="name">Supply Air Dry Bulb</field>
        <field name="section">Air Side</field>
        <field name="unit">°C</field>
        <field name="sequence">20</field>
    </record>
    <record id="mf_target_evap_exit" model="airlogic.measurement.field">
        <field name="code">target_evap_exit</field>
        <field name="name">Target Evaporator Exit</field>
        <field name="section">Air Side</field>
        <field name="unit">°C</field>
        <field name="sequence">30</field>
    </record>
    <record id="mf_return_wb" model="airlogic.measurement.field">
        <field name="code">return_wb</field>
        <field name="name">Return Air Wet Bulb</field>
        <field name="section">Air Side</field>
        <field name="unit">°C</field>
        <field name="sequence">40</field>
    </record>
    <record id="mf_supply_wb" model="airlogic.measurement.field">
        <field name="code">supply_wb</field>
        <field name="name">Supply Air Wet Bulb</field>
        <field name="section">Air Side</field>
        <field name="unit">°C</field>
        <field name="sequence">50</field>
    </record>
    <record id="mf_return_rh" model="airlogic.measurement.field">
        <field name="code">return_rh</field>
        <field name="name">Return RH%</field>
        <field name="section">Air Side</field>
        <field name="unit">%</field>
        <field name="sequence">60</field>
    </record>
    <record id="mf_supply_rh" model="airlogic.measurement.field">
        <field name="code">supply_rh</field>
        <field name="name">Supply RH%</field>
        <field name="section">Air Side</field>
        <field name="unit">%</field>
        <field name="sequence">70</field>
    </record>
    <record id="mf_return_dew" model="airlogic.measurement.field">
        <field name="code">return_dew</field>
        <field name="name">Return Dew Point</field>
        <field name="section">Air Side</field>
        <field name="unit">°C</field>
        <field name="sequence">80</field>
    </record>
    <record id="mf_supply_dew" model="airlogic.measurement.field">
        <field name="code">supply_dew</field>
        <field name="name">Supply Dew Point</field>
        <field name="section">Air Side</field>
        <field name="unit">°C</field>
        <field name="sequence">90</field>
    </record>
    <record id="mf_return_enthalpy" model="airlogic.measurement.field">
        <field name="code">return_enthalpy</field>
        <field name="name">Return Enthalpy</field>
        <field name="section">Air Side</field>
        <field name="unit">Btu/lbm</field>
        <field name="sequence">100</field>
    </record>
    <record id="mf_supply_enthalpy" model="airlogic.measurement.field">
        <field name="code">supply_enthalpy</field>
        <field name="name">Supply Enthalpy</field>
        <field name="section">Air Side</field>
        <field name="unit">Btu/lbm</field>
        <field name="sequence">110</field>
    </record>
    <record id="mf_cooling_airflow" model="airlogic.measurement.field">
        <field name="code">cooling_airflow</field>
        <field name="name">Cooling Airflow</field>
        <field name="section">Air Side</field>
        <field name="unit">CFM</field>
        <field name="sequence">120</field>
    </record>
    <record id="mf_cooling_capacity" model="airlogic.measurement.field">
        <field name="code">cooling_capacity</field>
        <field name="name">Cooling System Capacity</field>
        <field name="section">Air Side</field>
        <field name="unit">BTU/h</field>
        <field name="sequence">130</field>
    </record>
    <record id="mf_heating_airflow" model="airlogic.measurement.field">
        <field name="code">heating_airflow</field>
        <field name="name">Heating Airflow</field>
        <field name="section">Air Side</field>
        <field name="unit">CFM</field>
        <field name="sequence">140</field>
    </record>
    <record id="mf_heating_capacity" model="airlogic.measurement.field">
        <field name="code">heating_capacity</field>
        <field name="name">Heating System Capacity</field>
        <field name="section">Air Side</field>
        <field name="unit">BTU/h</field>
        <field name="sequence">150</field>
    </record>
    <record id="mf_delta_t" model="airlogic.measurement.field">
        <field name="code">delta_t</field>
        <field name="name">Delta T (T1-T2)</field>
        <field name="section">Air Side</field>
        <field name="unit">°C</field>
        <field name="standard">≥ 8 °C</field>
        <field name="sequence">160</field>
    </record>

    <!-- Refrigerant Side -->
    <record id="mf_ref_type" model="airlogic.measurement.field">
        <field name="code">ref_type</field>
        <field name="name">Refrigerant Type</field>
        <field name="section">Refrigerant Side</field>
        <field name="sequence">170</field>
    </record>
    <record id="mf_outdoor_db" model="airlogic.measurement.field">
        <field name="code">outdoor_db</field>
        <field name="name">Outdoor Dry Bulb Temp</field>
        <field name="section">Refrigerant Side</field>
        <field name="unit">°C</field>
        <field name="sequence">180</field>
    </record>
    <record id="mf_suction_pres" model="airlogic.measurement.field">
        <field name="code">suction_pres</field>
        <field name="name">Suction Line Pressure</field>
        <field name="section">Refrigerant Side</field>
        <field name="unit">psi</field>
        <field name="sequence">190</field>
    </record>
    <record id="mf_liquid_pres" model="airlogic.measurement.field">
        <field name="code">liquid_pres</field>
        <field name="name">Liquid Line Pressure</field>
        <field name="section">Refrigerant Side</field>
        <field name="unit">psi</field>
        <field name="sequence">200</field>
    </record>
    <record id="mf_vapor_sat" model="airlogic.measurement.field">
        <field name="code">vapor_sat</field>
        <field name="name">Vapor Saturation Temp</field>
        <field name="section">Refrigerant Side</field>
        <field name="unit">°C</field>
        <field name="sequence">210</field>
    </record>
    <record id="mf_liquid_sat" model="airlogic.measurement.field">
        <field name="code">liquid_sat</field>
        <field name="name">Liquid Saturation Temp</field>
        <field name="section">Refrigerant Side</field>
        <field name="unit">°C</field>
        <field name="sequence">220</field>
    </record>
    <record id="mf_suction_temp" model="airlogic.measurement.field">
        <field name="code">suction_temp</field>
        <field name="name">Suction Line Temperature</field>
        <field name="section">Refrigerant Side</field>
        <field name="unit">°C</field>
        <field name="sequence">230</field>
    </record>
    <record id="mf_liquid_temp" model="airlogic.measurement.field">
        <field name="code">liquid_temp</field>
        <field name="name">Liquid Line Temperature</field>
        <field name="section">Refrigerant Side</field>
        <field name="unit">°C</field>
        <field name="sequence">240</field>
    </record>
    <record id="mf_target_superheat" model="airlogic.measurement.field">
        <field name="code">target_superheat</field>
        <field name="name">Target Superheat</field>
        <field name="section">Refrigerant Side</field>
        <field name="unit">°C</field>
        <field name="sequence">250</field>
    </record>
    <record id="mf_actual_superheat" model="airlogic.measurement.field">
        <field name="code">actual_superheat</field>
        <field name="name">Actual Superheat</field>
        <field name="section">Refrigerant Side</field>
        <field name="unit">°C</field>
        <field name="sequence">260</field>
    </record>
    <record id="mf_target_subcooling" model="airlogic.measurement.field">
        <field name="code">target_subcooling</field>
        <field name="name">Target Subcooling</field>
        <field name="section">Refrigerant Side</field>
        <field name="unit">°C</field>
        <field name="sequence">270</field>
    </record>
    <record id="mf_actual_subcooling" model="airlogic.measurement.field">
        <field name="code">actual_subcooling</field>
        <field name="name">Actual Subcooling</field>
        <field name="section">Refrigerant Side</field>
        <field name="unit">°C</field>
        <field name="sequence">280</field>
    </record>

    <!-- Manometer Pressure -->
    <record id="mf_mano_p1" model="airlogic.measurement.field">
        <field name="code">mano_p1</field>
        <field name="name">Manometer P1</field>
        <field name="section">Manometer Pressure</field>
        <field name="unit">psi</field>
        <field name="sequence">290</field>
    </record>
    <record id="mf_mano_p2" model="airlogic.measurement.field">
        <field name="code">mano_p2</field>
        <field name="name">Manometer P2</field>
        <field name="section">Manometer Pressure</field>
        <field name="unit">psi</field>
        <field name="sequence">300</field>
    </record>
    <record id="mf_mano_diff" model="airlogic.measurement.field">
        <field name="code">mano_diff</field>
        <field name="name">P1 - P2</field>
        <field name="section">Manometer Pressure</field>
        <field name="unit">psi</field>
        <field name="sequence">310</field>
    </record>

</odoo>
