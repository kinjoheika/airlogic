<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="airlogic_core.VisualChecklist">
        <div class="o_airlogic_checklist">
            <div class="o_airlogic_checklist_header">
                <div>
                    <h2>Visual Checklist</h2>
                    <div class="o_airlogic_checklist_sub">
                        <t t-esc="params.equipment_name or 'Equipment'"/>
                        <t t-if="params.job_name"> · <t t-esc="params.job_name"/></t>
                    </div>
                </div>
                <div class="o_airlogic_checklist_progress">
                    <t t-esc="progress.done"/> / <t t-esc="progress.total"/> logged
                </div>
            </div>

            <div class="o_airlogic_phase_bar">
                <t t-foreach="phases" t-as="p" t-key="p.id">
                    <div t-att-class="'o_airlogic_phase_tab' + (state.phase === p.id ? ' active' : '')"
                         t-on-click="() => this.setPhase(p.id)">
                        Ph<t t-esc="p.id"/> — <t t-esc="p.title"/>
                    </div>
                </t>
            </div>

            <div class="o_airlogic_phase_body">
                <t t-foreach="currentPhase.items" t-as="item" t-key="item.key">
                    <div class="o_airlogic_item">
                        <div class="o_airlogic_item_label">
                            <span><t t-esc="item.label"/></span>
                            <span t-if="item.standard" class="o_airlogic_item_std">
                                <t t-esc="item.standard"/>
                            </span>
                        </div>
                        <div class="o_airlogic_item_control">
                            <t t-if="item.type === 'check'">
                                <button type="button" class="btn btn-sm"
                                        t-att-class="state.values[item.key] === 'ok' ? 'btn-success' : 'btn-outline-secondary'"
                                        t-on-click="() => this.setValue(item.key, 'ok')">✓ Normal</button>
                                <button type="button" class="btn btn-sm"
                                        t-att-class="state.values[item.key] === 'flagged' ? 'btn-danger' : 'btn-outline-secondary'"
                                        t-on-click="() => this.setValue(item.key, 'flagged')">⚠ Flagged</button>
                            </t>
                            <t t-if="item.type === 'number'">
                                <input type="number" step="0.1" class="form-control form-control-sm o_airlogic_number"
                                       t-att-value="state.values[item.key]"
                                       t-on-change="(ev) => this.onNumberChange(item.key, ev)"/>
                                <span t-if="item.unit" class="o_airlogic_unit"><t t-esc="item.unit"/></span>
                            </t>
                            <t t-if="item.type === 'leak'">
                                <button type="button" class="btn btn-sm"
                                        t-att-class="state.values[item.key] === 'pass' ? 'btn-success' : 'btn-outline-secondary'"
                                        t-on-click="() => this.setValue(item.key, 'pass')">✓ No Leak</button>
                                <button type="button" class="btn btn-sm"
                                        t-att-class="state.values[item.key] === 'leak' ? 'btn-danger' : 'btn-outline-secondary'"
                                        t-on-click="() => this.setValue(item.key, 'leak')">⚠ Leak</button>
                            </t>
                            <t t-if="item.type === 'text'">
                                <textarea class="form-control form-control-sm"
                                          t-on-change="(ev) => this.onTextChange(item.key, ev)"/>
                            </t>
                        </div>
                    </div>
                </t>
            </div>

            <div class="o_airlogic_phase_nav">
                <button type="button" class="btn btn-secondary" t-on-click="prevPhase" t-att-disabled="state.phase === 1">
                    Previous
                </button>
                <button t-if="state.phase &lt; phases.length" type="button" class="btn airlogic-btn-primary" t-on-click="nextPhase">
                    Next Phase
                </button>
                <button t-else="" type="button" class="btn airlogic-btn-invoice" t-on-click="onDone" t-att-disabled="state.saving">
                    <t t-if="state.saving">Saving…</t>
                    <t t-else="">Done</t>
                </button>
            </div>
        </div>
    </t>

</templates>
