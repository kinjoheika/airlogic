<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration list for the 30-field measurement tool. Editable inline so
  a manager can reorder (drag the sequence handle), relabel, or add/retire
  fields without touching code.
-->
<odoo>

    <record id="view_airlogic_measurement_field_list" model="ir.ui.view">
        <field name="name">airlogic.measurement.field.list</field>
        <field name="model">airlogic.measurement.field</field>
        <field name="arch" type="xml">
            <list string="Measurement Fields" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="section"/>
                <field name="name"/>
                <field name="pdf_label" optional="hide"/>
                <field name="code"/>
                <field name="unit"/>
                <field name="standard"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_airlogic_measurement_field_form" model="ir.ui.view">
        <field name="name">airlogic.measurement.field.form</field>
        <field name="model">airlogic.measurement.field</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Return Air Dry Bulb"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="pdf_label"/>
                            <field name="section"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="unit"/>
                            <field name="standard"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_airlogic_measurement_field" model="ir.actions.act_window">
        <field name="name">Measurement Fields</field>
        <field name="res_model">airlogic.measurement.field</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a measurement field</p>
            <p>These rows drive the Fieldpiece JobLink reading grid on every
               service job. Reorder with the drag handle, relabel, or set
               active to False to retire a field without deleting history.</p>
        </field>
    </record>

</odoo>
