<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration list for equipment categories + their per-unit rate.
  Editable inline so a manager can set/adjust rates without touching code.
-->
<odoo>

    <record id="view_airlogic_equipment_category_list" model="ir.ui.view">
        <field name="name">airlogic.equipment.category.list</field>
        <field name="model">airlogic.equipment.category</field>
        <field name="arch" type="xml">
            <list string="Equipment Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="rate"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_airlogic_equipment_category" model="ir.actions.act_window">
        <field name="name">Equipment Categories</field>
        <field name="res_model">airlogic.equipment.category</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define an equipment category</p>
            <p>Each equipment record picks one of these. The Rate here is
               what's charged per unit of this category on a visit's
               invoice.</p>
        </field>
    </record>

</odoo>
