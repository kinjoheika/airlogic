<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_airlogic_equipment_list" model="ir.ui.view">
        <field name="name">airlogic.equipment.list</field>
        <field name="model">airlogic.equipment</field>
        <field name="arch" type="xml">
            <list string="Equipment">
                <field name="partner_id"/>
                <field name="sublocation"/>
                <field name="name"/>
                <field name="serial_number"/>
                <field name="equipment_type"/>
                <field name="install_year"/>
                <field name="job_count"/>
            </list>
        </field>
    </record>

    <record id="view_airlogic_equipment_form" model="ir.ui.view">
        <field name="name">airlogic.equipment.form</field>
        <field name="model">airlogic.equipment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_jobs" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <field name="job_count" widget="statinfo" string="Service Jobs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Carrier 40MBFQ12"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="sublocation"/>
                            <field name="serial_number"/>
                        </group>
                        <group>
                            <field name="equipment_type"/>
                            <field name="install_year"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_airlogic_equipment_search" model="ir.ui.view">
        <field name="name">airlogic.equipment.search</field>
        <field name="model">airlogic.equipment</field>
        <field name="arch" type="xml">
            <search string="Equipment">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="partner_id"/>
                <field name="sublocation"/>
                <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_airlogic_equipment" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">airlogic.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_airlogic_equipment_search"/>
        <field name="context">{'search_default_group_partner': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add an aircon unit</p>
        </field>
    </record>

</odoo>
