<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_dispatch_request_technician_own" model="ir.rule">
        <field name="name">Technician: own dispatch requests only</field>
        <field name="model_id" ref="model_airlogic_dispatch_request"/>
        <field name="domain_force">[('requested_by', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('airlogic_core.group_airlogic_technician'))]"/>
    </record>

    <record id="rule_dispatch_request_supervisor_all" model="ir.rule">
        <field name="name">Operations Officer+: all dispatch requests</field>
        <field name="model_id" ref="model_airlogic_dispatch_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('airlogic_core.group_airlogic_supervisor'))]"/>
    </record>

</odoo>
