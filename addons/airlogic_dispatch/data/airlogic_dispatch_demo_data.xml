<?xml version="1.0" encoding="utf-8"?>
<!--
  40 demo dispatch requests (AIR-T55/Phase 6.5-6.6), spread across
  backlog/emergency/rush/routine and every zoned client, so the
  Dispatch Queue and Operations Officer schedule have real content to
  demo instead of an empty list. All left Pending on purpose: running
  the daily cron (or tapping Suggest) works them through the actual
  6-rule cascade against whatever real Technician-group users exist on
  this install, rather than baking in fake pre-computed results.

  Also seeds 2 new Ermita clients (Rizal Tower Offices, Manila Grand
  Suites) with 2 units each, since the 3 existing demo clients only
  cover Makati/Pasay/Quezon City. Cornerstone (Quezon City)
  deliberately has no zone, to demonstrate the engine's fallback path
  for an unzoned client too.
-->
<odoo noupdate="1">

    <!-- Zone the existing demo clients -->
    <record id="airlogic_core.demo_partner_meridian" model="res.partner">
        <field name="airlogic_dispatch_zone_id" ref="zone_makati_1"/>
    </record>
    <record id="airlogic_core.demo_partner_bayview" model="res.partner">
        <field name="airlogic_dispatch_zone_id" ref="zone_pasay_1"/>
    </record>

