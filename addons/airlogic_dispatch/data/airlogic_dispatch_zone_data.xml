<?xml version="1.0" encoding="utf-8"?>
<!--
  Starting zones per the user's own split: 5 for Makati, 3 for Pasay,
  3 for Ermita. noupdate="1" so a Manager renaming/adding zones under
  Configuration survives upgrades.
-->
<odoo noupdate="1">

    <record id="zone_makati_1" model="airlogic.dispatch.zone">
        <field name="name">Makati Zone 1</field>
        <field name="city">makati</field>
        <field name="sequence">10</field>
    </record>
    <record id="zone_makati_2" model="airlogic.dispatch.zone">
        <field name="name">Makati Zone 2</field>
        <field name="city">makati</field>
        <field name="sequence">20</field>
    </record>
    <record id="zone_makati_3" model="airlogic.dispatch.zone">
        <field name="name">Makati Zone 3</field>
        <field name="city">makati</field>
        <field name="sequence">30</field>
    </record>
    <record id="zone_makati_4" model="airlogic.dispatch.zone">
        <field name="name">Makati Zone 4</field>
        <field name="city">makati</field>
        <field name="sequence">40</field>
    </record>
    <record id="zone_makati_5" model="airlogic.dispatch.zone">
        <field name="name">Makati Zone 5</field>
        <field name="city">makati</field>
        <field name="sequence">50</field>
    </record>

    <record id="zone_pasay_1" model="airlogic.dispatch.zone">
        <field name="name">Pasay Zone 1</field>
        <field name="city">pasay</field>
        <field name="sequence">10</field>
    </record>
    <record id="zone_pasay_2" model="airlogic.dispatch.zone">
        <field name="name">Pasay Zone 2</field>
        <field name="city">pasay</field>
        <field name="sequence">20</field>
    </record>
    <record id="zone_pasay_3" model="airlogic.dispatch.zone">
        <field name="name">Pasay Zone 3</field>
        <field name="city">pasay</field>
        <field name="sequence">30</field>
    </record>

    <record id="zone_ermita_1" model="airlogic.dispatch.zone">
        <field name="name">Ermita Zone 1</field>
        <field name="city">ermita</field>
        <field name="sequence">10</field>
    </record>
    <record id="zone_ermita_2" model="airlogic.dispatch.zone">
        <field name="name">Ermita Zone 2</field>
        <field name="city">ermita</field>
        <field name="sequence">20</field>
    </record>
    <record id="zone_ermita_3" model="airlogic.dispatch.zone">
        <field name="name">Ermita Zone 3</field>
        <field name="city">ermita</field>
        <field name="sequence">30</field>
    </record>

</odoo>
